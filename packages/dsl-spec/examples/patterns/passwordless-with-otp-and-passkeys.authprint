  - id: e-e4b06381
    source: screen-f19aa283
    target: action-786f8bc0
    trigger:
      type: interaction
      action: submit
  - id: e-46097077
    source: action-786f8bc0
    target: outcome-409f7971
    trigger:
      type: on-success
  - id: e-5f1a857f
    source: screen-f19aa283
    target: outcome-409f7971
    trigger:
      type: interaction
      action: skip
scenarios:
  - id: sc-1
    name: Login with passkeys
    initialContext: {}
    inputScript:
      - type: screen
        nodeId: screen-f3a126e2
        action: continue-with-passkey
      - type: screen
        nodeId: screen-fa529672
        action: submit
      - type: action
        nodeId: action-74d2dc2e
        result: success
    expectedOutcome:
      outcomeId: outcome-4ab3851d
  - id: sc-2
    name: Login with OTP code
    initialContext:
      user_exists: true
    inputScript:
      - type: screen
        nodeId: screen-f3a126e2
        action: submit
      - type: action
        nodeId: action-b00ca654
        result: success
      - type: screen
        nodeId: screen-109ed5bd
        action: submit
      - type: action
        nodeId: action-2ad4834f
        result: success
    expectedOutcome:
      outcomeId: outcome-c38b7656
  - id: sc-3
    name: Signup and associate passkey
    initialContext:
      user_exists: false
    inputScript:
      - type: screen
        nodeId: screen-f3a126e2
        action: submit
      - type: action
        nodeId: action-b00ca654
        result: success
      - type: screen
        nodeId: screen-109ed5bd
        action: submit
