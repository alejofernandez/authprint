    source: screen-109ed5bd
    target: screen-f3a126e2
    trigger:
      type: interaction
      action: back
  - id: e-3d4f1646
    source: action-2ad4834f
    target: decision-f0c5cdbc
    trigger:
      type: on-success
  - id: e-b72137c8
    source: decision-f0c5cdbc
    target: screen-f58bc6ec
    trigger:
      type: branch
      value: false
  - id: e-0aa27f92
    source: decision-f0c5cdbc
