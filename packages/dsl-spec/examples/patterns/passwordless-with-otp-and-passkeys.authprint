id: pattern-passwordless-with-otp-and-passkeys
name: Passwordless with OTP and Passkeys
branding:
  theme: dark
  companyName: My Shop
  primaryColor: "#bf40bb"
context:
  user_exists:
    type: boolean
nodes:
  - type: entry
    id: entry
  - type: screen
    id: screen-f3a126e2
    name: Enter email or phone
    kind: identifier-collect
    traits:
      - passkey-promotion
    fields:
      - name: Phone or email
        type: text
        required: false
  - type: screen
    id: screen-fa529672
    name: Choose your passkey
    kind: passkey-auth
    traits:
      - error-banner
    fields:
      - name: passkey
        type: passkey
        required: false
  - type: action
    id: action-74d2dc2e
    name: Validate passkey
    kind: validate-credentials
  - type: outcome
    id: outcome-4ab3851d
    name: Authenticathed
    kind: authenticated
  - type: action
    id: action-b00ca654
    name: Send OTP code
    kind: send-otp
  - type: outcome
    id: outcome-0b7379f5
    name: Unexpected error
    kind: error
  - type: screen
    id: screen-109ed5bd
    name: Enter code
    kind: password
    traits:
      - error-banner
    fields:
      - name: Code
        type: otp
        required: false
  - type: action
    id: action-2ad4834f
    name: Verify OTP
    kind: validate-credentials
  - type: decision
    id: decision-f0c5cdbc
    name: User exists?
    kind: user-exists
    predicate:
      slot: user_exists
      op: equals
      value: true
  - type: screen
    id: screen-f58bc6ec
    name: Create your account
    kind: signup-confirmation
    traits:
      - terms-checkbox-required
      - marketing-opt-in
    fields:
      - name: First Name
        type: text
        required: false
      - name: Last Name
        type: text
        required: false
  - type: outcome
    id: outcome-c38b7656
    name: Authenticated
    kind: authenticated
  - type: screen
    id: screen-f19aa283
    name: New screen
    kind: passkey-enroll
    fields:
      - name: passkey
        type: passkey
        required: false
  - type: action
    id: action-79a2cd72
    name: Create account
    kind: create-user
  - type: outcome
    id: outcome-6777983e
    name: Unexpected error
    kind: error
  - type: action
    id: action-786f8bc0
    name: Associate passkey
    kind: enroll-factor
  - type: outcome
    id: outcome-409f7971
    name: Authenticated
    kind: authenticated
edges:
  - id: e-bb447b46
    source: entry
    target: screen-f3a126e2
    trigger:
      type: unconditional
  - id: e-0e31fc2f
    source: screen-f3a126e2
    target: screen-fa529672
    trigger:
      type: interaction
      action: continue-with-passkey
  - id: e-3e809799
    source: screen-fa529672
    target: action-74d2dc2e
    trigger:
      type: interaction
      action: submit
  - id: e-0fd19f5d
    source: screen-fa529672
    target: screen-f3a126e2
    trigger:
      type: interaction
      action: back
  - id: e-dd6dee94
    source: action-74d2dc2e
    target: screen-fa529672
    trigger:
      type: on-error
  - id: e-096db63f
    source: action-74d2dc2e
    target: outcome-4ab3851d
    trigger:
      type: on-success
